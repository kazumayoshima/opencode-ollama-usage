#!/usr/bin/env bash
# Ollama Cloud usage for a multi-line tmux bar with progress bars.
# Usage: ollama-usage [session|weekly|model|all]
# Reads the API key from the opencode auth.json (or $OLLAMA_API_KEY) and queries
# https://ollama.com/api/usage
# Only requires: bash, curl, awk, sed, date, stat.

AUTH="$HOME/.local/share/opencode/auth.json"
KEY="${OLLAMA_API_KEY:-}"
# if no OLLAMA_API_KEY, read the key from opencode (never printed)
if [ -z "$KEY" ] && [ -f "$AUTH" ]; then
  # {"ollama-cloud":{"type":"...","key":"..."}} -> extract key without json tools
  KEY=$(tr -d '[:space:]' < "$AUTH" | sed 's/.*"ollama-cloud"[^}]*"key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' 2>/dev/null)
fi

if [ -z "$KEY" ]; then
  echo "#[fg=red]ollama: no key#[default]"
  exit 0
fi

CACHE_BAL="$HOME/.cache/ollama-usage-balance.json"
CACHE_REQ="$HOME/.cache/ollama-usage-requests.json"
CACHE_TTL=60

# use cache if recent (stat is portable: -c on GNU, -f on BSD/macOS)
mtime() {
  if [ "$(uname -s)" = "Darwin" ]; then
    stat -f %m "$1" 2>/dev/null || echo 0
  else
    stat -c %Y "$1" 2>/dev/null || echo 0
  fi
}

# cached GET: reuse a recent cache file, otherwise fetch and store it.
cached_get() {
  local cache="$1" url="$2" body
  if [ -f "$cache" ] && [ $(( $(date +%s) - $(mtime "$cache") )) -lt $CACHE_TTL ]; then
    cat "$cache"
    return
  fi
  body=$(curl -s -m 5 -H "Authorization: Bearer $KEY" "$url" 2>/dev/null)
  if [ -n "$body" ]; then
    mkdir -p "$(dirname "$cache")"
    echo "$body" > "$cache"
  fi
  printf '%s' "$body"
}

# Since the late-2026 API change the usage percentages live in /api/balance
# (remaining_percent per window); /api/usage only reports request counts.
BAL=$(cached_get "$CACHE_BAL" "https://ollama.com/api/balance")
USAGE=$(cached_get "$CACHE_REQ" "https://ollama.com/api/usage?range=7d")
if [ -z "$BAL" ]; then
  echo "#[fg=yellow]ollama: n/a#[default]"
  exit 0
fi

# parse JSON (known fixed structure). Extract each value with basic tools:
# grep -o + sed. Works on any distribution.

# session/weekly: usage = 1 - remaining_percent/100
SESS_OBJ=$(echo "$BAL" | grep -o '"session":{[^}]*}')
WK_OBJ=$(echo "$BAL" | grep -o '"weekly":{[^}]*}' | head -1)
SREM=$(echo "$SESS_OBJ" | grep -o '"remaining_percent":[0-9.]*' | sed 's/.*://')
WREM=$(echo "$WK_OBJ" | grep -o '"remaining_percent":[0-9.]*' | sed 's/.*://')
SESS_AT=$(echo "$SESS_OBJ" | grep -o '"resets_at":"[^"]*"' | sed 's/.*:"//; s/"$//')
WK_AT=$(echo "$WK_OBJ" | grep -o '"resets_at":"[^"]*"' | sed 's/.*:"//; s/"$//')
SREM="${SREM:-100}"
WREM="${WREM:-100}"
SESS=$(awk -v r="$SREM" 'BEGIN{printf "%.4f",(100-r)/100}')
WK=$(awk -v r="$WREM" 'BEGIN{printf "%.4f",(100-r)/100}')

# weekly requests: use totals only (buckets would double-count)
REQ=$(echo "$USAGE" | grep -o '"totals":{[^}]*}' | grep -o '"request_count":[0-9]*' | sed 's/.*://')
REQ="${REQ:-0}"
# the API no longer reports per-model usage; keep the name if it ever returns
MODEL=$(echo "$USAGE" | grep -o '"name":"[^"]*"' | head -1 | sed 's/.*"name":"//; s/"$//')
MODEL="${MODEL:--}"

if ! echo "$SESS$WK" | grep -qE '^[0-9.eE-]+$' ; then
  echo "#[fg=yellow]ollama: n/a#[default]"
  exit 0
fi

# color by usage level (usage is a fraction 0..1)
color() {
  local u="$1"
  if awk -v u="$u" 'BEGIN{exit !(u>0.7)}' ; then echo "red"
  elif awk -v u="$u" 'BEGIN{exit !(u>0.4)}' ; then echo "yellow"
  else echo "green"; fi
}

# pct with one decimal
pct() { awk -v u="$1" 'BEGIN{printf "%.1f", u*100}'; }

# visual width in columns (wc -L does not exist on BSD/macOS).
# awk + LC_ALL=C: decodes UTF-8 codepoints. ASCII and East-Asian block chars
# (U+2580-U+259F, used for the bar fill) are width 1; all other multibyte
# chars (fullwidth labels) are width 2.
vwidth() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN{ for(k=0;k<256;k++) ch[k]=sprintf("%c",k) }
    {
      n=0; i=1; L=length($0)
      while(i<=L){
        b=substr($0,i,1); v=0
        for(k=0;k<256;k++) if(ch[k]==b){ v=k; break }
        if(v<128){ n+=1; i++; continue }
        if(v>=192){
          cp=v%32; i++
          while(i<=L){
            bb=substr($0,i,1); bv=0
            for(k=0;k<256;k++) if(ch[k]==bb){ bv=k; break }
            if(bv>=128 && bv<=191){ cp=cp*64 + bv%64; i++ }
            else break
          }
          # block elements U+2580..U+259F are single-width
          if(cp>=9600 && cp<=9631) n+=1
          else n+=2
        }
        else i++                             # loose continuation: width 0
      }
      printf "%d", n
    }'
}

# full-width progress bar: label + bar (filled) + % + reset
# width passed as $4 (optional); inside tmux use it via #{pane_width}
bar() {
  local u="$1"
  local label="$2"
  local r="$3"
  local width="$4"
  local fillcolor="$5"
  if [ -z "$width" ]; then
    width="${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}"
  fi
  # visual width of the label (vwidth: portable, wc -L does not exist on BSD/macOS)
  local labelw
  labelw=$(vwidth "$label")
  awk -v u="$u" -v label="$label" -v r="$r" -v width="$width" -v labelw="$labelw" -v fill="$fillcolor" '
    BEGIN{
      pct=sprintf("%.1f%%", u*100)
      text=sprintf("  %5s  resets in %s", pct, r)
      suffix="#[fg=colour255]" text
      barw=width - labelw - length(text) - 1
      if(barw<4) barw=4
      full=int(u*barw)
      frac=int((u*barw-full)*8)
      seg="▉▊▋▌▍▎▏"
      fillcode="#[fg=" fill "]"
      gray="#[fg=colour240]"
      out=""
      for(i=0;i<barw;i++){
        if(i<full) out=out fillcode "█"
        else if(i==full && frac>=1) out=out fillcode substr(seg,frac,1)
        else out=out gray "░"
      }
      printf "%s%s%s", label, out, suffix
    }'
}

# exact reset time from the API resets_at (ISO 8601 UTC) -> HH:MM:SS
iso_epoch() {
  # GNU date first, then BSD/macOS date
  date -u -d "$1" +%s 2>/dev/null \
    || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null
}

reset() {
  local at="$1" now nxt d
  now=$(date -u +%s)
  nxt=$(iso_epoch "$at")
  if [ -z "$nxt" ]; then echo "--:--:--"; return; fi
  d=$(( nxt - now ))
  if [ "$d" -lt 0 ]; then d=0; fi
  awk -v d="$d" 'BEGIN{
    h=int(d/3600); m=int((d%3600)/60); s=d%60
    printf "%02d:%02d:%02d", h, m, s
  }'
}

SESS_PCT=$(pct "$SESS")
WK_PCT=$(pct "$WK")
SESS_C=$(color "$SESS")
WK_C=$(color "$WK")
SESS_R=$(reset "$SESS_AT")
WK_R=$(reset "$WK_AT")

# the API no longer exposes per-model usage; degrade gracefully
if [ "$MODEL" = "-" ]; then
  MODEL_TEXT="Ollama Pro -  ${REQ} requests this week"
else
  MODEL_TEXT="Ollama Pro -  Model most used this week  ${MODEL} · ${REQ} requests"
fi

# center text in the pane width, leaving space on the left (tabs)
# and on the right (clock). Usage: centered <text> <width>
centered() {
  local text="$1"
  local width="$2"
  local textw leftw
  textw=$(vwidth "$text")
  # reserve ~10 cols left (tabs) and ~10 cols right (clock)
  local avail=$(( width - 20 ))
  leftw=$(( (avail - textw) / 2 ))
  if [ "$leftw" -lt 0 ]; then leftw=0; fi
  awk -v n="$leftw" 'BEGIN{ for(i=0;i<n;i++) printf " " }'
  printf '%s' "$text"
}

# colorize bar: colored fill, rest gray
sess() { bar "$SESS" "Ｓｅｓｓｉｏｎ  Ｕｓａｇｅ  " "$SESS_R" "$1" "$SESS_C"; }
week() { bar "$WK" "Ｗｅｅｋｌｙ    Ｕｓａｇｅ  " "$WK_R" "$1" "$WK_C"; }

case "${1:-all}" in
  session)
    echo "#[bg=colour236]#[fg=colour255]$(sess "$2")#[default]"
    ;;
  weekly)
    echo "#[bg=colour236]#[fg=colour255]$(week "$2")#[default]"
    ;;
  model)
    echo "#[bg=colour236]#[fg=colour255]$(centered "$MODEL_TEXT" "$2")#[default]"
    ;;
  all)
    echo "#[bg=colour236]#[fg=colour255]$(sess "$2")#[default]"
    echo "#[bg=colour236]#[fg=colour255]$(week "$2")#[default]"
    echo "#[bg=colour236]#[fg=colour255]$(centered "$MODEL_TEXT" "$2")#[default]"
    ;;
esac
