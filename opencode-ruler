#!/usr/bin/env bash
# Generates a horizontal line (ruler) the width of the pane (minus 1 border col).
# Usage: opencode-ruler [width]   (width optional; default: tput cols)
width="${1:-${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}}"
width=$(( width - 1 ))
awk -v w="$width" 'BEGIN{ if(w<0) w=0; for(i=0;i<w;i++) printf "─" }'
