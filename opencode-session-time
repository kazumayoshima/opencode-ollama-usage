#!/usr/bin/env bash
# Shows the elapsed session time since opencode-tmux was opened.
# The timestamp is stored in a file when the session is created.

STAMP="$HOME/.cache/opencode-session-start"
if [ ! -f "$STAMP" ]; then
  echo "0:00"
  exit 0
fi

START=$(cat "$STAMP")
NOW=$(date +%s)
ELAPSED=$(( NOW - START ))
H=$(( ELAPSED / 3600 ))
M=$(( (ELAPSED % 3600) / 60 ))
S=$(( ELAPSED % 60 ))

if [ "$H" -gt 0 ]; then
  printf "%d:%02d:%02d" "$H" "$M" "$S"
else
  printf "%d:%02d" "$M" "$S"
fi
